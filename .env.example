# ==============================================================================
# Cloud Data Lakehouse Pipeline - Environment Configuration Template
# ==============================================================================

# Execution Environment: 'local', 'minio', or 'aws'
ENVIRONMENT=local

# Storage Paths (Local or Cloud URIs)
DATA_LAKE_BASE_PATH=./lakehouse_storage
RAW_INPUT_PATH=./data/sample_transactions.csv
BRONZE_TABLE_PATH=./lakehouse_storage/bronze/transactions
SILVER_TABLE_PATH=./lakehouse_storage/silver/transactions
GOLD_CUSTOMER_MART_PATH=./lakehouse_storage/gold/customer_360
GOLD_REGIONAL_MART_PATH=./lakehouse_storage/gold/regional_sales
QUARANTINE_PATH=./lakehouse_storage/quarantine/transactions

# AWS S3 / MinIO S3-Compatible Credentials
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=lakehouse-data
S3_PATH_STYLE_ACCESS=true
S3_SSL_ENABLED=false

# Spark Engine Optimization Tuning
SPARK_APP_NAME=CloudDataLakehousePipeline
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_SQL_SHUFFLE_PARTITIONS=4

# Delta Lake Compaction & Retention
DELTA_AUTO_OPTIMIZE_OPTIMIZE_WRITE=true
DELTA_AUTO_OPTIMIZE_AUTO_COMPACT=true
DELTA_VACUUM_RETENTION_HOURS=168

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
